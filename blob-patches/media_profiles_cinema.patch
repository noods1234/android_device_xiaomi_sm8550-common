 <?xml version="1.0" encoding="utf-8"?>
 <!-- Qualcomm Technologies Inc. Kalama media profiles -->
+<!--
+  Cinema profiles added for ishtar (Xiaomi 13 Ultra) cinema conversion:
+    CINEMA_4K_24       : 4K UHD 24fps HEVC @ 120 Mbps  (cinematic 24p)
+    CINEMA_4K_60       : 4K UHD 60fps HEVC @ 160 Mbps  (high-frame-rate)
+    CINEMA_8K_24       : 8K     24fps HEVC @ 200 Mbps  (maximum quality)
+    CINEMA_FHD_120     : 1080p 120fps HEVC @ 60 Mbps   (slow-motion)
+
+  Bitrate rationale:
+    ProRes 422 HQ 4K@24 ≈ 1050 Mbps (hardware encode not available on SM8550)
+    HEVC 10-bit 4K@24  @ 120 Mbps is perceptually equivalent after chroma
+    subsampling; suitable for professional post-production delivery.
+
+  These profiles are additive — existing stock profiles are preserved.
+  Apply via Magisk bind-mount or bake into ROM vendor partition.
+-->
 <MediaSettings>
     <!-- Each camcorder profile defines the format/subformat for recording video.
          Each profile has a name and supports a specific combination of video/audio
@@ -10,6 +26,46 @@
          If a profile is not available, the corresponding fields would be set to -1. -->

