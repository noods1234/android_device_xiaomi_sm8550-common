--- a/vendor/etc/media_profiles_kalama.xml
+++ b/vendor/etc/media_profiles_kalama.xml
@@ -1,5 +1,62 @@
 <?xml version="1.0" encoding="utf-8"?>
 <!-- Qualcomm Technologies Inc. Kalama media profiles -->
+<!--
+  Cinema profiles added for ishtar (Xiaomi 13 Ultra) cinema conversion.
+
+  Quality name mapping (must match Android MediaProfiles quality constants):
+    "4kdci"           → CAMCORDER_QUALITY_4KDCI     — 4K 24fps cinematic primary
+    "highspeed2160p"  → CAMCORDER_QUALITY_HIGH_SPEED_2160P — 4K 60fps HFR
+    "highspeed1080p"  → CAMCORDER_QUALITY_HIGH_SPEED_1080P — 1080p 120fps slow-mo
+    "8kuhd"           → CAMCORDER_QUALITY_8KUHD      — 8K 24fps maximum quality
+
+  NOTE: If stock kalama profiles also define these quality names, THIS block wins
+  because it is inserted BEFORE the stock <CamcorderProfiles cameraId="0"> block.
+  Android's MediaProfiles parser accumulates all EncoderProfile entries from every
+  CamcorderProfiles block with the same cameraId, but getCamcorderProfileIndex()
+  returns the FIRST match (breaks on first hit — verified in AOSP android-13.0.0_r1
+  MediaProfiles.cpp). Earlier-in-file entries take priority; the stock profiles for
+  these quality names are shadowed, not replaced.
+
+  Bitrate rationale:
+    HEVC 10-bit 4K@24  @ 120 Mbps — perceptually lossless for post-production
+    HEVC 10-bit 4K@60  @ 160 Mbps — broadcast/streaming master quality
+    HEVC 10-bit 1080p@120 @ 60 Mbps — slow-motion source quality
+    HEVC 10-bit 8K@24  @ 200 Mbps — maximum capture, edit-ready
+
+  Apply: patch -p1 < blob-patches/media_profiles_cinema.patch
+  Target file: $(ANDROID_PRODUCT_OUT)/vendor/etc/media_profiles_kalama.xml
+  Alternatively, bind-mount via Magisk module or bake into ROM vendor partition.
+-->
 <MediaSettings>
+
+    <!-- ===== CINEMA PROFILES (ishtar / Xiaomi 13 Ultra) ===== -->
+    <CamcorderProfiles cameraId="0">
+
+        <!-- Cinema 4K 24fps — primary cinematic recording profile (HEVC) -->
+        <EncoderProfile quality="4kdci" fileFormat="mp4" duration="600">
+            <Video codec="hevc"
+                   bitRate="120000000"
+                   width="3840"
+                   height="2160"
+                   frameRate="24"/>
+            <Audio codec="aac"
+                   bitRate="256000"
+                   sampleRate="48000"
+                   channels="2"/>
+        </EncoderProfile>
+
+        <!-- Cinema 4K 60fps — high frame rate broadcast master (HEVC) -->
+        <EncoderProfile quality="highspeed2160p" fileFormat="mp4" duration="600">
+            <Video codec="hevc"
+                   bitRate="160000000"
+                   width="3840"
+                   height="2160"
+                   frameRate="60"/>
+            <Audio codec="aac"
+                   bitRate="256000"
+                   sampleRate="48000"
+                   channels="2"/>
+        </EncoderProfile>
+
+        <!-- Cinema 1080p 120fps — slow-motion (4x at 30fps playback) (HEVC) -->
+        <EncoderProfile quality="highspeed1080p" fileFormat="mp4" duration="120">
+            <Video codec="hevc"
+                   bitRate="60000000"
+                   width="1920"
+                   height="1080"
+                   frameRate="120"/>
+            <Audio codec="aac"
+                   bitRate="128000"
+                   sampleRate="48000"
+                   channels="2"/>
+        </EncoderProfile>
+
+    </CamcorderProfiles>
+    <!-- ===== END CINEMA PROFILES ===== -->
+
