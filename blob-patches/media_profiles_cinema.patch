--- a/vendor/etc/media_profiles_kalama.xml
+++ b/vendor/etc/media_profiles_kalama.xml
@@ -1,3 +1,150 @@
 <?xml version="1.0" encoding="utf-8"?>
 <!-- Qualcomm Technologies Inc. Kalama media profiles -->
+<!--
+  Cinema profiles added for ishtar (Xiaomi 13 Ultra) cinema conversion.
+
+  Quality name mapping (must match Android MediaProfiles quality constants):
+    "4kdci"           → CAMCORDER_QUALITY_4KDCI               — 4K 24fps cinematic primary
+    "2160p"           → CAMCORDER_QUALITY_2160P                — 4K 30fps standard recording
+    "highspeed2160p"  → CAMCORDER_QUALITY_HIGH_SPEED_2160P     — 4K 60fps HFR; VIDEO ONLY
+    "1080p"           → CAMCORDER_QUALITY_1080P                — 1080p 30fps standard recording
+    "highspeed1080p"  → CAMCORDER_QUALITY_HIGH_SPEED_1080P     — 1080p 120fps slow-motion; VIDEO ONLY
+    "highspeed720p"   → CAMCORDER_QUALITY_HIGH_SPEED_720P      — 720p 240fps ultra slow-motion; VIDEO ONLY
+
+  CAMCORDER_QUALITY_HIGH_SPEED_* profiles use CameraConstrainedHighSpeedCaptureSession,
+  which does not support simultaneous audio recording. No <Audio> element is present in
+  those profiles: adding one would silently mislead capability queries without any effect.
+  Audio for slow-motion clips must be added in post-production or via a separate pass.
+
+  Front camera (cameraId="1") cinema profiles:
+    "2160p"  — 4K 30fps HEVC override (Sony IMX663, confirmed 4K@30fps capable)
+    "1080p"  — 1080p 30fps HEVC override
+
+  NOTE: These blocks are inserted BEFORE the stock <CamcorderProfiles> blocks.
+  Android's MediaProfiles parser uses getCamcorderProfileIndex() which returns
+  the FIRST match; earlier-in-file entries shadow later entries for the same
+  quality name. Stock profiles for these quality names are shadowed, not replaced.
+  This applies to both cameraId="0" and cameraId="1" blocks: if stock profiles
+  exist for the same quality name on the same cameraId, cinema profiles win.
+
+  Idempotency: blob_fixup.patch_file() always operates on a freshly-extracted
+  blob, so double-apply cannot occur in normal build usage. Manual re-apply via
+  `patch` is safe: the patch command detects already-applied hunks and aborts.
+
+  Bit depth note: HEVC bit depth (8-bit vs 10-bit) is determined entirely by the
+  camera HAL output surface format (YUV_420_888 vs YCBCR_P010) and encoder
+  configuration at runtime. These profiles cannot enforce 10-bit encoding; that
+  depends on camera HAL support and the recording application's session setup.
+
+  Bitrate rationale (HEVC, bit depth determined by camera HAL):
+    4K@24fps    120 Mbps — perceptually lossless for post-production
+    4K@30fps     80 Mbps — high-quality standard recording master
+    4K@60fps    160 Mbps — HFR broadcast; video-only (constrained HFR session); capped at 300s
+    1080p@30fps  20 Mbps — broadcast quality standard recording
+    1080p@120fps 60 Mbps — slow-motion source; video-only (constrained HFR session); capped at 120s
+    720p@240fps  64 Mbps — ultra slow-motion; video-only (constrained HFR session); capped at 30s
+    front 4K@30  50 Mbps — front sensor limited vs rear main sensor; capped at 300s
+    front 1080p  16 Mbps — front standard HD
+
+  Applied automatically via extract-files.py blob_fixup (patch_file).
+  Manual: patch -p1 < blob-patches/media_profiles_cinema.patch
+  Target: $(ANDROID_PRODUCT_OUT)/vendor/etc/media_profiles_kalama.xml
+-->
 <MediaSettings>
+
+    <!-- ===== CINEMA PROFILES (ishtar / Xiaomi 13 Ultra) ===== -->
+
+    <!-- == Rear camera (cameraId="0") == -->
+    <CamcorderProfiles cameraId="0">
+
+        <!-- Cinema 4K 24fps — cinematic primary profile (UHD 3840×2160, not DCI 4096×2160) (HEVC) -->
+        <EncoderProfile quality="4kdci" fileFormat="mp4" duration="600">
+            <Video codec="hevc"
+                   bitRate="120000000"
+                   width="3840"
+                   height="2160"
+                   frameRate="24"/>
+            <Audio codec="aac"
+                   bitRate="256000"
+                   sampleRate="48000"
+                   channels="2"/>
+        </EncoderProfile>
+
+        <!-- Cinema 4K 30fps — standard 4K recording (HEVC) -->
+        <EncoderProfile quality="2160p" fileFormat="mp4" duration="600">
+            <Video codec="hevc"
+                   bitRate="80000000"
+                   width="3840"
+                   height="2160"
+                   frameRate="30"/>
+            <Audio codec="aac"
+                   bitRate="256000"
+                   sampleRate="48000"
+                   channels="2"/>
+        </EncoderProfile>
+
+        <!-- Cinema 4K 60fps — HFR broadcast master (HEVC); VIDEO ONLY:
+             CameraConstrainedHighSpeedCaptureSession does not support audio recording. -->
+        <EncoderProfile quality="highspeed2160p" fileFormat="mp4" duration="300">
+            <Video codec="hevc"
+                   bitRate="160000000"
+                   width="3840"
+                   height="2160"
+                   frameRate="60"/>
+        </EncoderProfile>
+
+        <!-- Cinema 1080p 30fps — standard HD recording (HEVC) -->
+        <EncoderProfile quality="1080p" fileFormat="mp4" duration="600">
+            <Video codec="hevc"
+                   bitRate="20000000"
+                   width="1920"
+                   height="1080"
+                   frameRate="30"/>
+            <Audio codec="aac"
+                   bitRate="256000"
+                   sampleRate="48000"
+                   channels="2"/>
+        </EncoderProfile>
+
+        <!-- Cinema 1080p 120fps — slow-motion (4x at 30fps playback) (HEVC); VIDEO ONLY:
+             CameraConstrainedHighSpeedCaptureSession does not support audio recording. -->
+        <EncoderProfile quality="highspeed1080p" fileFormat="mp4" duration="120">
+            <Video codec="hevc"
+                   bitRate="60000000"
+                   width="1920"
+                   height="1080"
+                   frameRate="120"/>
+        </EncoderProfile>
+
+        <!-- Cinema 720p 240fps — ultra slow-motion (8x at 30fps playback) (HEVC); VIDEO ONLY:
+             CameraConstrainedHighSpeedCaptureSession does not support audio recording.
+             duration=30s intentional: SM8550 thermal/encoder limit at 240fps. -->
+        <EncoderProfile quality="highspeed720p" fileFormat="mp4" duration="30">
+            <Video codec="hevc"
+                   bitRate="64000000"
+                   width="1280"
+                   height="720"
+                   frameRate="240"/>
+        </EncoderProfile>
+
+    </CamcorderProfiles>
+
+    <!-- == Front camera (cameraId="1") == -->
+    <CamcorderProfiles cameraId="1">
+
+        <!-- Cinema 4K 30fps — front camera standard 4K (HEVC) -->
+        <EncoderProfile quality="2160p" fileFormat="mp4" duration="300">
+            <Video codec="hevc"
+                   bitRate="50000000"
+                   width="3840"
+                   height="2160"
+                   frameRate="30"/>
+            <Audio codec="aac"
+                   bitRate="256000"
+                   sampleRate="48000"
+                   channels="2"/>
+        </EncoderProfile>
+
+        <!-- Cinema 1080p 30fps — front camera standard HD (HEVC) -->
+        <EncoderProfile quality="1080p" fileFormat="mp4" duration="600">
+            <Video codec="hevc"
+                   bitRate="16000000"
+                   width="1920"
+                   height="1080"
+                   frameRate="30"/>
+            <Audio codec="aac"
+                   bitRate="256000"
+                   sampleRate="48000"
+                   channels="2"/>
+        </EncoderProfile>
+
+    </CamcorderProfiles>
+    <!-- ===== END CINEMA PROFILES ===== -->
+
