+                   bitRate="160000000"
+                   width="3840"
+                   height="2160"
+                   frameRate="60"/>
+            <Audio codec="aac"
+                   bitRate="256000"
+                   sampleRate="48000"
+                   channels="2"/>
+        </EncoderProfile>
+
+        <!-- Cinema 1080p 120fps — slow-motion (4x at 30fps playback) -->
