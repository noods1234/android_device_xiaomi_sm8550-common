# Audio
# MiSound ASC (adaptive loudness) disabled: consistent with misound.disable; prevents
# dynamics processing from masking true levels during monitoring playback.
persist.vendor.audio.misoundasc=false
persist.vendor.audio.misound.disable=true
ro.audio.monitorRotation=true
# Spatializer disabled: spatial transforms on output alter the dry mix, making
# on-device monitoring non-representative of the recorded signal.
# ro.audio.spatializer_enabled is the AOSP-standard control (Spatializer.cpp).
# ro.vendor.audio.feature.spatial is NOT overridden: its bitmask definitions are
# opaque to this tree and clearing all bits could disable audio input features
# (e.g. QAHDR multi-capsule processing) beyond the targeted output spatializer.
ro.audio.spatializer_enabled=false
ro.vendor.audio.misound.bluetooth.enable=false

# Bluetooth
persist.sys.fflag.override.settings_bluetooth_hearing_aid=true
persist.vendor.qcom.bluetooth.a2dp_offload_cap=sbc-aptx-aptxtws-aptxhd-aac-ldac-aptxadaptiver2
persist.vendor.qcom.bluetooth.aac_frm_ctl.enabled=true
persist.vendor.qcom.bluetooth.aac_vbr_ctl.enabled=true
persist.vendor.qcom.bluetooth.aptxadaptiver2_1_support=true

# Camera
# ZSL enabled for Camera2 complete control: allows CONTROL_CAPTURE_INTENT_ZERO_SHUTTER_LAG,
# burst capture, and reprocessing streams. The HAL maintains a circular pre-capture buffer
# so stills can be pulled from a running preview without a capture latency penalty.
camera.disable_zsl_mode=false
ro.camera.enableCamera1MaxZsl=1

# Display
persist.sys.sf.native_mode=257
ro.vendor.display.ai_disp.enable=false
ro.vendor.display.mi_calib.enable=true
# Nature mode (blue-light filter) disabled: engagement during colour monitoring
# shifts the white point toward amber, corrupting any colorimetric reference work.
ro.vendor.display.nature_mode.enable=false
ro.vendor.display.type=oled
ro.vendor.displayfeature.dump=true
ro.vendor.fps.switch.default=true
# Thermal frame rate switching disabled: automatic refresh rate changes during
# sustained recording would alter motion cadence during monitoring.
ro.vendor.fps.switch.thermal=false
# HBM disabled: High Brightness Mode changes panel luminance characteristics
# beyond the calibrated operating point, invalidating display-based exposure
# and colour monitoring. Ambient sensor triggers must not alter the reference.
ro.vendor.hbm_backlight.enable=false
ro.vendor.histogram.enable=true
ro.vendor.localhbm.enable=false
# Thermal display dimming disabled: brightness must remain stable during
# sustained recording sessions so that monitoring luminance is consistent.
ro.vendor.thermal.dimming.enable=false
ro.vendor.xiaomi.bl.poll=true

# DPM
persist.vendor.dpm.vndr.feature=11
persist.vendor.dpm.vndr.halservice.enable=1
persist.vendor.dpm.vndr.idletimer.mode=default

# DRM
drm.service.enabled=true

# FM
vendor.hw.fm.init=0

# FUSE passthrough
persist.sys.fuse.passthrough.enable=true

# Incremental FS
ro.incremental.enable=yes

# Keystore
ro.hardware.keystore_desede=true

# Media
debug.stagefright.c2inputsurface=-1
media.stagefright.enable-aac=true
media.stagefright.enable-fma2dp=true
media.stagefright.enable-http=true
media.stagefright.enable-player=true
media.stagefright.enable-qcp=true
media.stagefright.enable-scan=true
media.stagefright.thumbnail.prefer_hw_codecs=true
ro.mediaserver.64b.enable=true
vendor.media.omx=0

# NFC
ro.vendor.nfc.disable.i2c=false
ro.vendor.nfc.dispatch_optim=1
ro.vendor.nfc.repair=1
ro.vendor.se.type=HCE,UICC

# Telephony
persist.vendor.radio.redir_party_num=0
ro.vendor.radio.build_profile=u-stable
ro.vendor.radio.build_region=global

# USB
ro.usb.uvc.enabled=true
